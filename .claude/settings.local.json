{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "256000"
  },
  "permissions": {
    "allow": [
      "mcp__laravel-boost__browser-logs",
      "mcp__laravel-boost__database-schema",
      "mcp__laravel-boost__database-query",
      "mcp__laravel-boost__application-info",
      "mcp__laravel-boost__search-docs",
      "Bash(php -v)",
      "Bash(php -m)",
      "Bash(dir *)",
      "Bash(php artisan *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(composer run *)",
      "Bash(vendor/bin/pint *)",
      "Bash(vendor/bin/phpstan analyse:*)",
      "Bash(composer show:*)",
      "WebSearch",
      "Bash(vendor/bin/pint --format agent)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git commit -m 'fix: restore blade files to production state *)",
      "Bash(git commit -m 'fix: eager load category relationship in OutletProducts to prevent lazy loading exception *)",
      "Bash(vendor/bin/pest --filter=ProductVariationOptionTest --compact)",
      "Bash(git commit -m 'fix: specify HasFactory template to resolve static analysis warning *)",
      "Bash(git commit -m 'feat: complete critical test coverage gaps for PIANO_IMPLEMENTAZIONE *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ],
  "outputStyle": "default"
}
