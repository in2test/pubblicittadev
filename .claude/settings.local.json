{
    "env": {
        "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "256000"
    },
    "permissions": {
        "allow": [
            "mcp__laravel-boost__browser-logs",
            "mcp__laravel-boost__database-schema",
            "mcp__laravel-boost__database-query",
            "mcp__laravel-boost__application-info",
            "mcp__laravel-boost__search-docs",
            "Bash(php -v)",
            "Bash(php -m)",
            "Bash(dir *)",
            "Bash(php artisan *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push *)",
            "Bash(git restore *)",
            "Bash(git checkout *)",
            "Bash(composer run *)",
            "Bash(vendor/bin/pint *)",
            "Bash(vendor/bin/phpstan analyse:*)",
            "Bash(composer show:*)",
            "WebSearch",
            "Bash(vendor/bin/pint *)",
            "Bash(vendor/bin/pest *)",
            "mcp__laravel-boost__read-log-entries",
            "Bash(php artisan tinker *)"
        ]
    },
    "enableAllProjectMcpServers": true,
    "enabledMcpjsonServers": ["laravel-boost"],
    "outputStyle": "default"
}
